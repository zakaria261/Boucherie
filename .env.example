# Adresse publique du site. Indispensable en production.
APP_ORIGIN=https://votre-domaine.fr

# Code utilisé une seule fois pour créer le premier accès propriétaire.
# Choisissez une valeur longue, aléatoire et gardez-la secrète.
ADMIN_SETUP_TOKEN=remplacez-cette-valeur-par-un-code-long-et-secret

# Facultatif : chemin vers le volume persistant qui conserve les produits,
# commandes et photos téléversées. Par défaut : ./data
# BOUCHERIE_DATA_DIR=/chemin/vers/le-volume-persistant
