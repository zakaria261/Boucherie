# Adresse publique du site (HTTPS). Indispensable en production :
# liens de suivi, sitemap, protection des formulaires.
APP_ORIGIN=https://www.boucheriedufaubourg-amiens.com

# Code utilisé une seule fois pour créer l'accès propriétaire.
# Choisissez une valeur longue, aléatoire, et gardez-la secrète.
ADMIN_SETUP_TOKEN=remplacez-cette-valeur-par-un-code-long-et-secret

# Base de données Turso (obligatoire sur Vercel ; ajoutées automatiquement
# quand la base Turso est reliée au projet). Sans elles : fichier local
# data/boutique.sqlite, pour le développement.
# TURSO_DATABASE_URL=libsql://…turso.io
# TURSO_AUTH_TOKEN=

# Stockage des photos Vercel Blob (obligatoire sur Vercel ; ajouté
# automatiquement quand le Blob store est relié au projet). Sans lui : data/uploads.
# BLOB_READ_WRITE_TOKEN=

# Facultatif, hors Vercel : dossier de la base et des photos locales (défaut : ./data)
# BOUCHERIE_DATA_DIR=/chemin/vers/le-volume-persistant

# Facultatif : clés Web Push. Sans elles, une paire est générée et conservée
# dans la base au premier usage. À fixer si plusieurs serveurs partagent la base.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Facultatif : envois WhatsApp automatiques (API WhatsApp Cloud de Meta).
# Sans ces valeurs, aucun envoi automatique n'est tenté ni affiché comme fait.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANGUAGE=fr
# WHATSAPP_OWNER_TEMPLATE=       # nouvelle commande → boucherie
# WHATSAPP_CUSTOMER_TEMPLATE=    # confirmation → client (s'il l'accepte)
# WHATSAPP_STATUS_TEMPLATE=      # changement de statut → client
